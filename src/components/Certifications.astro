---
import jsCert      from '../assets/certificaciones/javascript-coderhouse.png';
import csharpCert  from '../assets/certificaciones/poo-csharp.jpg';
import wpCert      from '../assets/certificaciones/wordpress-woocommerce.jpg';
import britishCert from '../assets/certificaciones/britishschool-english-2.pdf';

const certs = [
  {
    title: "JavaScript — Desarrollo Web",
    issuer: "CoderHouse",
    date: "2024",
    type: "image" as const,
    file: jsCert.src,
    desc: "JS moderno, DOM, asincronismo y buenas prácticas",
    glowColor: "#F7DF1E",
    illustration: `<svg viewBox="0 0 320 176" xmlns="http://www.w3.org/2000/svg">
      <!-- bg -->
      <rect width="320" height="176" fill="#1C1C1C"/>
      <!-- subtle grid -->
      <rect width="320" height="176" fill="url(#jsgrid)" opacity="0.06"/>
