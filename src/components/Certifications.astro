---
import jsCert    from '../assets/certificaciones/javascript-coderhouse.png';
import csharpCert from '../assets/certificaciones/poo-csharp.jpg';
import wpCert    from '../assets/certificaciones/wordpress-woocommerce.jpg';
import britishCert from '../assets/certificaciones/britishschool-english-2.pdf';

const certs = [
  { title: "JavaScript — Desarrollo Web", issuer: "CoderHouse",          date: "2024", type: "image", file: jsCert.src,    desc: "JS moderno, DOM, asincronismo y buenas prácticas" },
  { title: "POO — C# & .NET",             issuer: "Curso especializado", date: "2024", type: "image", file: csharpCert.src, desc: "Programación orientada a objetos con C# y .NET" },
  { title: "WordPress & WooCommerce",     issuer: "Desarrollo Web",      date: "2024", type: "image", file: wpCert.src,     desc: "E-commerce, contenidos y personalización avanzada" },
  { title: "English II — Intensive",      issuer: "British School",      date: "2023", type: "pdf",   file: britishCert,    desc: "Nivel básico/intermedio certificado" },
];

const achievements = [
  { title: "Autoclinic · Gestión de talleres", ctx: "Seminario académico",  year: "2025", desc: "Sistema de gestión para talleres mecánicos con turnos, clientes y vehículos." },
  { title: "Sistema de ventas Python",          ctx: "Freelance",            year: "2024", desc: "App de escritorio para panadería con facturas PDF y reportes automatizados." },
  { title: "GoGo Travel · Landing",            ctx: "Freelance",            year: "2023", desc: "Landing WordPress para agencia de viajes con SEO y formularios optimizados." },
];
---

<section id="certifications" class="py-24 sm:py-32" style="background:var(--bg)">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="mb-12 animate-fade-up">
      <p class="text-xs font-medium uppercase tracking-widest mb-3" style="color:var(--accent)">Formación</p>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold" style="color:var(--text-1)">
        Certificaciones
      </h2>
      <p class="mt-4 text-sm sm:text-base max-w-xl" style="color:var(--text-2)">
        Formación continua que respalda mi práctica profesional.
      </p>
    </div>

    <!-- Certs grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-14">
      {certs.map((c, i) => (
        <div
          class="group rounded-2xl border overflow-hidden transition-all duration-200 hover:border-[var(--accent)] hover:shadow-[var(--sh-md)] animate-fade-up"
          style={`background:var(--bg-card); border-color:var(--border); animation-delay:${i * 0.08}s`}
        >
          <!-- Preview -->
          <div class="relative h-36 overflow-hidden" style="background:var(--bg-muted)">
            {c.type === 'image' ? (
              <img src={c.file} alt={c.title}
                class="w-full h-full object-cover cursor-pointer open-cert group-hover:scale-105 transition-transform duration-300"
                data-file={c.file} data-title={c.title} data-type="image"/>
            ) : (
              <div class="w-full h-full flex flex-col items-center justify-center gap-2 cursor-pointer open-cert transition-colors duration-200 hover:text-[var(--accent)]"
                style="color:var(--text-3)"
                data-file={c.file} data-title={c.title} data-type="pdf">
                <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                <span class="text-xs">Ver PDF</span>
              </div>
            )}
          </div>

          <!-- Info -->
          <div class="p-4">
            <div class="flex items-start justify-between gap-2 mb-1">
              <h3 class="text-xs font-medium leading-snug" style="color:var(--text-1)">{c.title}</h3>
              <span class="text-xs shrink-0 tabular-nums" style="color:var(--text-3)">{c.date}</span>
            </div>
            <p class="text-xs mb-2" style="color:var(--accent)">{c.issuer}</p>
            <p class="text-xs leading-relaxed mb-3" style="color:var(--text-3)">{c.desc}</p>
            <button
              class="w-full py-1.5 text-xs font-medium rounded-lg border transition-all duration-200 hover:bg-[var(--accent-bg)] hover:border-[var(--accent)] hover:text-[var(--accent)] open-cert"
              style="border-color:var(--border); color:var(--text-2)"
              data-file={c.file} data-title={c.title} data-type={c.type}>
              Ver certificación
            </button>
          </div>
        </div>
      ))}
    </div>

    <!-- Achievements -->
    <div class="mb-2">
      <h3 class="text-sm font-medium mb-5" style="color:var(--text-1)">Proyectos destacados</h3>
      <div class="grid sm:grid-cols-3 gap-4">
        {achievements.map((a, i) => (
          <div
            class="p-5 rounded-2xl border transition-colors duration-200 hover:border-[var(--accent)] animate-fade-up"
            style={`background:var(--bg-muted); border-color:var(--border); animation-delay:${i * 0.1 + 0.2}s`}
          >
            <div class="flex items-center justify-between mb-2">
              <h4 class="text-sm font-medium" style="color:var(--text-1)">{a.title}</h4>
              <span class="text-xs tabular-nums shrink-0 ml-2" style="color:var(--text-3)">{a.year}</span>
            </div>
            <p class="text-xs mb-2" style="color:var(--accent)">{a.ctx}</p>
            <p class="text-xs leading-relaxed" style="color:var(--text-2)">{a.desc}</p>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<!-- Modal -->
<div id="certModal" class="fixed inset-0 z-50 hidden items-center justify-center p-4"
  style="background:rgba(0,0,0,0.7); backdrop-filter:blur(6px)">
  <div class="w-full max-w-4xl max-h-[90vh] rounded-2xl border overflow-hidden flex flex-col"
    style="background:var(--bg-card); border-color:var(--border)">
    <div class="flex items-center justify-between px-5 py-4 border-b shrink-0" style="border-color:var(--border-soft)">
      <h3 id="modalTitle" class="text-sm font-medium" style="color:var(--text-1)"></h3>
      <button id="closeModalBtn" class="p-1.5 rounded-lg transition-colors duration-200"
        style="color:var(--text-3)"
        onmouseenter="this.style.background='var(--bg-muted)'"
        onmouseleave="this.style.background='transparent'"
        aria-label="Cerrar">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <div id="modalContent" class="p-5 overflow-auto"></div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    function openModal(file: string, title: string, type: 'image' | 'pdf') {
      const modal   = document.getElementById('certModal');
      const mTitle  = document.getElementById('modalTitle');
      const mContent= document.getElementById('modalContent');
      if (!modal || !mTitle || !mContent) return;

      mTitle.textContent = title;
      if (type === 'image') {
        mContent.innerHTML = `<img src="${file}" alt="${title}" class="w-full h-auto rounded-xl">`;
      } else {
        mContent.innerHTML = `
          <div>
            <div class="mb-3 flex justify-end">
              <a href="${file}" target="_blank" rel="noopener" class="text-xs px-3 py-1.5 rounded-lg border hover:border-[var(--accent)] hover:text-[var(--accent)] transition-colors" style="border-color:var(--border);color:var(--text-2)">Abrir en nueva pestaña</a>
            </div>
            <iframe src="${file}#toolbar=1" class="w-full rounded-xl border" style="height:65vh;border-color:var(--border)" title="${title}"></iframe>
            <div class="mt-4 text-center">
              <a href="${file}" download class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl text-sm font-medium text-white transition-opacity hover:opacity-90" style="background:var(--accent)">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                Descargar PDF
              </a>
            </div>
          </div>`;
      }
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeModal() {
      const modal = document.getElementById('certModal');
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
    }

    document.getElementById('certModal')?.addEventListener('click', (e) => {
      if (e.target === document.getElementById('certModal')) closeModal();
    });
    document.getElementById('closeModalBtn')?.addEventListener('click', closeModal);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

    document.querySelectorAll('.open-cert').forEach(el => {
      el.addEventListener('click', () => {
        openModal(
          el.getAttribute('data-file') ?? '',
          el.getAttribute('data-title') ?? '',
          (el.getAttribute('data-type') ?? 'image') as 'image' | 'pdf'
        );
      });
    });
  });
</script>
