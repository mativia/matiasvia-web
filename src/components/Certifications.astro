      <text x="22" y="106" font-family="monospace" font-size="11" fill="#34D399" opacity="0.5">    await fetch(url)</text>
      <text x="22" y="124" font-family="monospace" font-size="11" fill="#F7DF1E" opacity="0.45">    return res.json()</text>
      <text x="22" y="142" font-family="monospace" font-size="11" fill="#6B7280" opacity="0.4">  }</text>
      <!-- JS logo right -->
      <rect x="182" y="22" width="118" height="118" rx="14" fill="#F7DF1E"/>
      <!-- JS text inside logo -->
      <text x="196" y="116" font-family="Arial Black, Impact, sans-serif" font-size="68" font-weight="900" fill="#1C1C1C">JS</text>
      <!-- bottom label -->
      <text x="22" y="162" font-family="Arial, sans-serif" font-size="9" fill="#4B5563">CoderHouse · JavaScript · 2024</text>
    </svg>`,
  },
  {
    title: "POO — C# & .NET",
    issuer: "Curso especializado",
    date: "2024",
    type: "image" as const,
    file: csharpCert.src,
    desc: "Programación orientada a objetos con C# y .NET",
    glowColor: "#A855F7",
    illustration: `<svg viewBox="0 0 320 176" xmlns="http://www.w3.org/2000/svg">
      <!-- bg -->
      <rect width="320" height="176" fill="#0F0A1E"/>
      <!-- glow circle -->
      <circle cx="160" cy="88" r="72" fill="#512BD4" opacity="0.12"/>
      <!-- C# symbol, large -->
      <text x="68" y="126" font-family="Arial Black, Impact, sans-serif" font-size="88" font-weight="900" fill="#9B4DCA" opacity="0.95">C#</text>
      <!-- OOP class diagram top-right -->
      <!-- parent class box -->
      <rect x="238" y="18" width="68" height="28" rx="5" fill="#2D1F45" stroke="#7C3AED" stroke-width="1"/>
      <text x="249" y="36" font-family="monospace" font-size="9" fill="#C084FC">Vehicle</text>
      <!-- arrow down -->
      <line x1="272" y1="46" x2="272" y2="60" stroke="#7C3AED" stroke-width="1" stroke-dasharray="3,2"/>
      <polygon points="268,58 272,66 276,58" fill="#7C3AED"/>
      <!-- child class 1 -->
      <rect x="222" y="66" width="50" height="26" rx="5" fill="#2D1F45" stroke="#A855F7" stroke-width="1"/>
      <text x="230" y="83" font-family="monospace" font-size="9" fill="#C084FC">Car</text>
      <!-- child class 2 -->
      <rect x="278" y="66" width="36" height="26" rx="5" fill="#2D1F45" stroke="#A855F7" stroke-width="1"/>
      <text x="283" y="83" font-family="monospace" font-size="9" fill="#C084FC">Bus</text>
      <!-- keyword pills -->
      <rect x="18" y="148" width="56" height="18" rx="9" fill="#2D1F45" stroke="#7C3AED" stroke-width="0.8"/>
      <text x="27" y="160" font-family="monospace" font-size="8.5" fill="#C084FC">inherit</text>
      <rect x="82" y="148" width="64" height="18" rx="9" fill="#2D1F45" stroke="#7C3AED" stroke-width="0.8"/>
      <text x="91" y="160" font-family="monospace" font-size="8.5" fill="#C084FC">polymor.</text>
      <rect x="154" y="148" width="58" height="18" rx="9" fill="#2D1F45" stroke="#7C3AED" stroke-width="0.8"/>
      <text x="162" y="160" font-family="monospace" font-size="8.5" fill="#C084FC">encaps.</text>
      <!-- .NET badge -->
      <rect x="240" y="148" width="62" height="18" rx="9" fill="#512BD4" opacity="0.5"/>
      <text x="256" y="160" font-family="Arial, sans-serif" font-size="9" font-weight="bold" fill="#E9D5FF">.NET</text>
    </svg>`,
  },
  {
    title: "WordPress & WooCommerce",
    issuer: "Desarrollo Web",
    date: "2024",
    type: "image" as const,
    file: wpCert.src,
    desc: "E-commerce, contenidos y personalización avanzada",
    glowColor: "#3B82F6",
    illustration: `<svg viewBox="0 0 320 176" xmlns="http://www.w3.org/2000/svg">
      <!-- bg -->
      <rect width="320" height="176" fill="#0D1E30"/>
      <!-- WP circle logo -->
      <circle cx="108" cy="84" r="64" fill="#21759B" opacity="0.15"/>
      <circle cx="108" cy="84" r="60" fill="none" stroke="#21759B" stroke-width="2.5" opacity="0.7"/>
      <circle cx="108" cy="84" r="52" fill="none" stroke="#21759B" stroke-width="0.8" opacity="0.3"/>
      <!-- W letterform (WordPress logo) -->
      <text x="64" y="118" font-family="Georgia, 'Times New Roman', serif" font-size="78" font-weight="bold" fill="#21759B">W</text>
      <!-- vertical separator -->
      <line x1="195" y1="24" x2="195" y2="152" stroke="#1E3A5F" stroke-width="1"/>
      <!-- WooCommerce side -->
      <!-- bag shape -->
      <path d="M230 76 L222 120 L298 120 L290 76 Z" fill="#96588A" opacity="0.25" stroke="#96588A" stroke-width="1.2"/>
      <path d="M244 76 Q256 54 268 76" fill="none" stroke="#96588A" stroke-width="2.5" stroke-linecap="round"/>
      <!-- bag lines -->
      <line x1="226" y1="96" x2="294" y2="96" stroke="#96588A" stroke-width="1" opacity="0.5"/>
      <line x1="224" y1="108" x2="296" y2="108" stroke="#96588A" stroke-width="1" opacity="0.4"/>
      <!-- cart icon -->
      <circle cx="238" cy="128" r="5" fill="#96588A" opacity="0.7"/>
      <circle cx="278" cy="128" r="5" fill="#96588A" opacity="0.7"/>
      <!-- labels -->
      <text x="208" y="152" font-family="Arial, sans-serif" font-size="8.5" fill="#96588A" opacity="0.8">WooCommerce</text>
      <text x="22" y="164" font-family="Arial, sans-serif" font-size="9" fill="#21759B" opacity="0.6">WordPress · PHP · E-commerce · 2024</text>
    </svg>`,
  },
  {
    title: "English II — Intensive",
    issuer: "British School",
    date: "2023",
    type: "pdf" as const,
    file: britishCert,
    desc: "Certificación de nivel básico / intermedio",
    glowColor: "#EF4444",
    illustration: `<svg viewBox="0 0 320 176" xmlns="http://www.w3.org/2000/svg">
      <!-- bg -->
      <rect width="320" height="176" fill="#0A1628"/>
      <!-- Union Jack flag area -->
      <rect x="18" y="22" width="172" height="110" rx="8" fill="#012169"/>
      <clipPath id="flagclip"><rect x="18" y="22" width="172" height="110" rx="8"/></clipPath>
      <g clip-path="url(#flagclip)">
        <!-- St Andrew diagonal white -->
        <line x1="18" y1="22"  x2="190" y2="132" stroke="white" stroke-width="30"/>
        <line x1="190" y1="22" x2="18"  y2="132" stroke="white" stroke-width="30"/>
        <!-- St Patrick diagonal red -->
        <line x1="18" y1="22"  x2="190" y2="132" stroke="#C8102E" stroke-width="14"/>
        <line x1="190" y1="22" x2="18"  y2="132" stroke="#C8102E" stroke-width="14"/>
        <!-- St George cross white border -->
        <rect x="18" y="67"  width="172" height="42" fill="white"/>
        <rect x="86" y="22"  width="40"  height="110" fill="white"/>
        <!-- St George cross red -->
        <rect x="18" y="73"  width="172" height="30" fill="#C8102E"/>
        <rect x="92" y="22"  width="28"  height="110" fill="#C8102E"/>
      </g>
      <!-- flag border -->
      <rect x="18" y="22" width="172" height="110" rx="8" fill="none" stroke="#1E3A5F" stroke-width="1.5"/>
      <!-- Right side branding -->
      <text x="205" y="60"  font-family="Georgia, serif" font-size="15" font-weight="bold" fill="#F1F5F9">British</text>
      <text x="205" y="80"  font-family="Georgia, serif" font-size="15" font-weight="bold" fill="#F1F5F9">School</text>
      <line x1="205" y1="90" x2="302" y2="90" stroke="#1E3A5F" stroke-width="1"/>
      <text x="205" y="107" font-family="Arial, sans-serif" font-size="10" fill="#7A99C4">English II</text>
      <text x="205" y="122" font-family="Arial, sans-serif" font-size="10" fill="#7A99C4">Intensive Course</text>
      <!-- level badge -->
      <rect x="205" y="132" width="80" height="20" rx="10" fill="#1E3A5F" stroke="#3B82F6" stroke-width="0.8"/>
      <text x="218" y="146" font-family="Arial, sans-serif" font-size="9" fill="#93C5FD">B1 · Intermedio</text>
      <!-- bottom -->
      <text x="18" y="165" font-family="Arial, sans-serif" font-size="9" fill="#4B5563">British School · Córdoba · 2023</text>
    </svg>`,
  },
];

const achievements = [
  { title: "Autoclinic · Gestión de talleres", ctx: "Seminario académico", year: "2025", desc: "Sistema de gestión para talleres mecánicos con turnos, clientes y vehículos." },
  { title: "Sistema de ventas Python",         ctx: "Freelance",           year: "2024", desc: "App de escritorio para panadería con facturas PDF y reportes automatizados." },
  { title: "GoGo Travel · Landing",           ctx: "Freelance",           year: "2023", desc: "Landing WordPress para agencia de viajes con SEO y formularios optimizados." },
];
---

<section id="certifications" class="py-24 sm:py-32" style="background:var(--bg)">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="mb-12 animate-fade-up">
      <p class="text-xs font-medium uppercase tracking-widest mb-3" style="color:var(--accent)">Formación</p>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold" style="color:var(--text-1)">
        Certificaciones
      </h2>
      <p class="mt-4 text-sm sm:text-base max-w-xl" style="color:var(--text-2)">
        Formación continua que respalda mi práctica profesional.
      </p>
    </div>

    <!-- Certs grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-14">
      {certs.map((c, i) => (
        <div
          class="cert-card group rounded-2xl border overflow-hidden transition-all duration-300 hover:border-[var(--accent)] hover:shadow-[var(--sh-lg)] hover:-translate-y-1 animate-fade-up cursor-pointer open-cert"
          style={`background:var(--bg-card); border-color:var(--border); animation-delay:${i * 0.08}s`}
          data-file={c.file} data-title={c.title} data-type={c.type}
        >

          <!-- ── Visual preview ── -->
          <div class="cert-preview relative h-44 overflow-hidden"
            style={`--glow:${c.glowColor}`}>

            <!-- SVG illustration (fills entire area) -->
            <div class="absolute inset-0 w-full h-full" set:html={c.illustration}></div>

            <!-- Subtle vignette overlay -->
            <div class="absolute inset-0"
              style="background:linear-gradient(to top, rgba(0,0,0,0.35) 0%, transparent 60%)"></div>

            <!-- Glow orb (accent, hover) -->
            <div class="absolute w-40 h-40 rounded-full blur-3xl opacity-0 group-hover:opacity-20 transition-opacity duration-500 pointer-events-none"
              style={`background:${c.glowColor}; top:50%; left:50%; transform:translate(-50%,-50%)`}></div>

            <!-- Shimmer sweep on hover -->
            <div class="cert-shimmer absolute inset-0 pointer-events-none"></div>

            <!-- "Ver cert" overlay on hover -->
            <div class="absolute inset-0 flex items-end justify-center pb-4 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
              <span class="px-3 py-1 rounded-full text-xs font-medium backdrop-blur-sm"
                style="background:rgba(0,0,0,0.5); color:white; border:1px solid rgba(255,255,255,0.2)">
                Ver certificación →
              </span>
            </div>
          </div>

          <!-- Info -->
          <div class="p-4">
            <div class="flex items-start justify-between gap-2 mb-1">
              <h3 class="text-xs font-medium leading-snug" style="color:var(--text-1)">{c.title}</h3>
              <span class="text-xs shrink-0 tabular-nums" style="color:var(--text-3)">{c.date}</span>
            </div>
            <p class="text-xs mb-1.5" style={`color:${c.glowColor}`}>{c.issuer}</p>
            <p class="text-xs leading-relaxed" style="color:var(--text-3)">{c.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Achievements -->
    <div>
      <h3 class="text-sm font-medium mb-5" style="color:var(--text-1)">Proyectos destacados</h3>
      <div class="grid sm:grid-cols-3 gap-4">
        {achievements.map((a, i) => (
          <div
            class="p-5 rounded-2xl border transition-colors duration-200 hover:border-[var(--accent)] animate-fade-up"
            style={`background:var(--bg-muted); border-color:var(--border); animation-delay:${i * 0.1 + 0.3}s`}
          >
            <div class="flex items-center justify-between mb-2">
              <h4 class="text-sm font-medium" style="color:var(--text-1)">{a.title}</h4>
              <span class="text-xs tabular-nums shrink-0 ml-2" style="color:var(--text-3)">{a.year}</span>
            </div>
            <p class="text-xs mb-2" style="color:var(--accent)">{a.ctx}</p>
            <p class="text-xs leading-relaxed" style="color:var(--text-2)">{a.desc}</p>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<!-- Modal -->
<div id="certModal" class="fixed inset-0 z-50 hidden items-center justify-center p-4"
  style="background:rgba(0,0,0,0.75); backdrop-filter:blur(8px)">
  <div class="w-full max-w-4xl max-h-[90vh] rounded-2xl border overflow-hidden flex flex-col"
    style="background:var(--bg-card); border-color:var(--border)">
    <div class="flex items-center justify-between px-5 py-4 border-b shrink-0" style="border-color:var(--border-soft)">
      <h3 id="modalTitle" class="text-sm font-medium" style="color:var(--text-1)"></h3>
      <button id="closeModalBtn"
        class="p-1.5 rounded-lg transition-colors duration-200 hover:bg-[var(--bg-muted)]"
        style="color:var(--text-3)"
        aria-label="Cerrar">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <div id="modalContent" class="p-5 overflow-auto"></div>
  </div>
</div>

<style>
  /* Dot grid overlay */
  .dot-grid {
    background-image: radial-gradient(circle, rgba(255,255,255,0.12) 1px, transparent 1px);
    background-size: 20px 20px;
    opacity: 0.6;
  }

  /* Shimmer sweep */
  .cert-shimmer {
    background: linear-gradient(
      105deg,
      transparent 40%,
      rgba(255, 255, 255, 0.06) 50%,
      transparent 60%
    );
    background-size: 200% 100%;
    background-position: 200% 0;
    transition: background-position 0s;
  }
  .cert-card:hover .cert-shimmer {
    background-position: -200% 0;
    transition: background-position 0.6s ease;
  }

  /* SVG fills preview area */
  .cert-preview svg {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    function openModal(file: string, title: string, type: 'image' | 'pdf') {
      const modal    = document.getElementById('certModal');
      const mTitle   = document.getElementById('modalTitle');
      const mContent = document.getElementById('modalContent');
      if (!modal || !mTitle || !mContent) return;

      mTitle.textContent = title;

      if (type === 'image') {
        mContent.innerHTML = `<img src="${file}" alt="${title}" class="w-full h-auto rounded-xl">`;
      } else {
        mContent.innerHTML = `
          <div>
            <div class="mb-3 flex justify-end">
              <a href="${file}" target="_blank" rel="noopener"
                class="text-xs px-3 py-1.5 rounded-lg border transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]"
                style="border-color:var(--border); color:var(--text-2)">
                Abrir en nueva pestaña
              </a>
            </div>
            <iframe src="${file}#toolbar=1" class="w-full rounded-xl border"
              style="height:65vh; border-color:var(--border)" title="${title}"></iframe>
            <div class="mt-4 text-center">
              <a href="${file}" download
                class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl text-sm font-medium text-white hover:opacity-90 transition-opacity"
                style="background:var(--accent)">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                    d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                Descargar PDF
              </a>
            </div>
          </div>`;
      }

      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeModal() {
      const modal = document.getElementById('certModal');
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
    }

    document.getElementById('certModal')?.addEventListener('click', (e) => {
      if (e.target === document.getElementById('certModal')) closeModal();
    });
    document.getElementById('closeModalBtn')?.addEventListener('click', closeModal);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

    document.querySelectorAll('.open-cert').forEach(el => {
      el.addEventListener('click', () => {
        openModal(
          el.getAttribute('data-file') ?? '',
          el.getAttribute('data-title') ?? '',
          (el.getAttribute('data-type') ?? 'image') as 'image' | 'pdf'
        );
      });
    });
  });
</script>
