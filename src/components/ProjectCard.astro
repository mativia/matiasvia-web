    <rect x="122" y="20" width="88" height="140" rx="10" fill="#0D2318" stroke="#34D399" stroke-width="1"/>
    <rect x="126" y="24" width="80" height="56" rx="6" fill="#102D22" opacity="0.8"/>
    <rect x="130" y="90" width="72" height="8" rx="3" fill="#1A4030"/>
    <rect x="130" y="103" width="50" height="6" rx="3" fill="#1A4030" opacity="0.6"/>
    <rect x="130" y="115" width="40" height="18" rx="5" fill="#059669" opacity="0.4"/>
    <text x="150" y="128" fill="#34D399" font-size="9" font-family="monospace">Comprar</text>
    <rect x="220" y="20" width="88" height="140" rx="10" fill="#0D2318" stroke="#1A4030" stroke-width="0.8"/>
    <rect x="224" y="24" width="80" height="56" rx="6" fill="#0A2820" opacity="0.8"/>
    <rect x="228" y="90" width="72" height="8" rx="3" fill="#1A4030"/>
    <rect x="228" y="103" width="50" height="6" rx="3" fill="#1A4030" opacity="0.6"/>
    <rect x="228" y="115" width="40" height="18" rx="5" fill="#059669" opacity="0.2"/>
    <text x="248" y="128" fill="#34D399" font-size="9" font-family="monospace">Comprar</text>
    <text x="164" y="170" text-anchor="middle" fill="#34D399" font-size="8" font-family="monospace" opacity="0.4">woocommerce · php</text>
  </svg>`,

  web: `<svg width="100%" height="100%" viewBox="0 0 360 180" xmlns="http://www.w3.org/2000/svg">
    <rect width="360" height="180" fill="#15101F"/>
    <rect x="20" y="14" width="320" height="152" rx="10" fill="#100D1A" stroke="#2D1F45" stroke-width="0.8"/>
    <rect x="20" y="14" width="320" height="26" rx="10" fill="#1A1428"/>
    <rect x="20" y="34" width="320" height="6" fill="#1A1428"/>
    <circle cx="36" cy="27" r="4" fill="#FF5F57" opacity="0.6"/>
    <circle cx="52" cy="27" r="4" fill="#FEBC2E" opacity="0.6"/>
    <circle cx="68" cy="27" r="4" fill="#28C840" opacity="0.6"/>
    <rect x="100" y="21" width="160" height="12" rx="5" fill="#211830"/>
    <rect x="20" y="50" width="320" height="34" fill="#13102A" opacity="0.6"/>
    <rect x="36" y="60" width="200" height="8" rx="3" fill="#8B5CF6" opacity="0.3"/>
