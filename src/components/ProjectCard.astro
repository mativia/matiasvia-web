    <rect x="228" y="120" width="48" height="6" rx="3" fill="#2D1F45" opacity="0.5"/>
    <rect x="228" y="131" width="56" height="6" rx="3" fill="#2D1F45" opacity="0.4"/>
    <rect x="228" y="142" width="40" height="6" rx="3" fill="#2D1F45" opacity="0.3"/>
