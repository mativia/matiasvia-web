    <text x="52" y="90" fill="#FF7B72" font-size="9" font-family="monospace">def</text>
    <text x="80" y="90" fill="#D2A8FF" font-size="9" font-family="monospace">generar_reporte</text>
    <text x="196" y="90" fill="#C9D1D9" font-size="9" font-family="monospace">(db):</text>
    <text x="36" y="105" fill="#4A6FA5" font-size="8" font-family="monospace" opacity="0.5">4</text>
    <text x="68" y="105" fill="#79C0FF" font-size="9" font-family="monospace">conn</text>
