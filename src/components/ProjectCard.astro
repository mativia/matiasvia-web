---
export interface Props {
  title: string;
  description: string;
  technologies: string[];
  badge?: "destacado" | "freelance" | "académico" | "e-commerce";
  year?: string;
  category?: "automatización" | "e-commerce" | "web" | "académico";
  githubUrl?: string;
  liveUrl?: string;
  featured?: boolean;
  illustration?: string;
}

const {
  title, description, technologies,
  badge, year, category = "web",
  githubUrl, liveUrl, featured = false,
  illustration,
} = Astro.props;

const badgeCfg: Record<string, { label: string; cls: string }> = {
  destacado:  { label: "★ Destacado",  cls: "bg-amber-500/10 text-amber-400 border-amber-500/30" },
  freelance:  { label: "Freelance",    cls: "bg-emerald-500/10 text-emerald-400 border-emerald-500/30" },
  académico:  { label: "Académico",    cls: "bg-purple-500/10 text-purple-400 border-purple-500/30" },
  "e-commerce":{ label: "E-commerce", cls: "bg-blue-500/10 text-blue-400 border-blue-500/30" },
};

const illustrationBg: Record<string, string> = {
  automatización: "#0F1F3A",
  "e-commerce":   "#0A1F18",
  web:            "#15101F",
  académico:      "#1A1228",
};

const illustrationSvg: Record<string, string> = {
