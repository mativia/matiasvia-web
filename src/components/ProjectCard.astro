    <rect x="46" y="68" width="220" height="6" rx="3" fill="#2D1F45" opacity="0.4"/>
    <rect x="30" y="85" width="300" height="0.8" fill="#2D1F45"/>
    <rect x="46" y="96" width="100" height="8" rx="3" fill="#7C3AED" opacity="0.2"/>
    <rect x="46" y="110" width="140" height="6" rx="3" fill="#2D1F45" opacity="0.5"/>
    <rect x="46" y="121" width="110" height="6" rx="3" fill="#2D1F45" opacity="0.4"/>
