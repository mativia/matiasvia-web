const bg  = illustrationBg[category] ?? illustrationBg.web;
const svg = illustration ?? illustrationSvg[category] ?? illustrationSvg.web;
const b   = badge ? badgeCfg[badge] : null;

const cardBorder = (featured || badge === "destacado")
  ? "border-amber-500/30 hover:border-amber-400/60"
  : "border-[var(--border)] hover:border-[var(--accent)]";
---

<article
  class={`group flex flex-col rounded-2xl border overflow-hidden transition-all duration-300 hover:shadow-[var(--sh-lg)] hover:-translate-y-0.5 ${cardBorder}`}
  style={`background:var(--bg-card)`}
>
  <!-- Illustration -->
  <div class="relative overflow-hidden" style={`height:168px; background:${bg}`}>
    <div class="absolute inset-0" set:html={svg}></div>

    <!-- Hover overlay -->
    <div class="absolute inset-0 flex items-center justify-center gap-3 opacity-0 group-hover:opacity-100 transition-all duration-300"
      style="background:rgba(0,0,0,0.65)">
      {liveUrl && (
        <a href={liveUrl} target="_blank" rel="noopener noreferrer"
          class="flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs font-medium text-white transition-colors duration-200"
          style="background:var(--accent)"
          onclick="event.stopPropagation()">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          Demo
        </a>
      )}
      {githubUrl && (
        <a href={githubUrl} target="_blank" rel="noopener noreferrer"
          class="flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs font-medium border transition-colors duration-200"
          style="background:rgba(255,255,255,0.1); border-color:rgba(255,255,255,0.2); color:white"
          onclick="event.stopPropagation()">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
          Código
        </a>
      )}
    </div>
  </div>

  <!-- Body -->
  <div class="flex flex-col flex-1 p-5">
    <!-- Badge + year -->
    <div class="flex items-center justify-between mb-3">
      {b ? (
        <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium border ${b.cls}`}>
          {b.label}
        </span>
      ) : <span></span>}
      {year && <span class="text-xs" style="color:var(--text-3)">{year}</span>}
    </div>

    <!-- Title -->
    <h3 class="font-display text-base font-semibold leading-snug mb-2 transition-colors duration-200 group-hover:text-[var(--accent)]"
      style="color:var(--text-1)">
      {title}
    </h3>

    <!-- Description -->
    <p class="text-xs leading-relaxed mb-4 flex-1" style="color:var(--text-2)">
      {description}
    </p>

    <!-- Tech stack -->
    <div class="flex flex-wrap gap-1.5 mb-4">
      {technologies.map(t => (
        <span class="px-2.5 py-0.5 rounded-full text-xs border"
          style="color:var(--text-2); border-color:var(--border); background:var(--bg-muted)">
          {t}
        </span>
      ))}
    </div>

    <!-- Footer -->
    <div class="flex items-center justify-between pt-3 border-t" style="border-color:var(--border-soft)">
      <span class="text-xs capitalize" style="color:var(--text-3)">{category}</span>
      {githubUrl && (
        <a href={githubUrl} target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-xs font-medium transition-colors duration-200 hover:underline"
          style="color:var(--accent)">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
          Ver código
        </a>
      )}
    </div>
  </div>
</article>
