---
---

<section id="contact" class="py-24 sm:py-32" style="background:var(--bg-muted)">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="mb-12 animate-fade-up">
      <p class="text-xs font-medium uppercase tracking-widest mb-3" style="color:var(--accent)">¿Necesitás un desarrollador?</p>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold mb-4" style="color:var(--text-1)">
        Hablemos
      </h2>
      <p class="text-sm sm:text-base max-w-xl" style="color:var(--text-2)">
        Estoy buscando mi primera posición en una empresa de tecnología. Si tu equipo necesita alguien que
        entregue, aprenda rápido y trabaje bien con otros, me encantaría conectar.
      </p>
    </div>

    <div class="grid lg:grid-cols-5 gap-8 lg:gap-12">

      <!-- Info (2/5) -->
      <div class="lg:col-span-2 space-y-4 animate-fade-up delay-100">

        <!-- Availability card -->
        <div class="p-5 rounded-2xl border"
          style="background:color-mix(in srgb,var(--green) 8%,transparent); border-color:color-mix(in srgb,var(--green) 25%,transparent)">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2 h-2 rounded-full bg-[var(--green)] animate-pulse"></span>
            <span class="text-sm font-medium" style="color:var(--green)">Disponible · Incorporación inmediata</span>
          </div>
          <p class="text-xs leading-relaxed" style="color:color-mix(in srgb,var(--green) 80%,var(--text-2))">
            Busco mi primera posición en una empresa tech. También acepto proyectos freelance y colaboraciones puntuales.
          </p>
        </div>

        <!-- Contact info -->
        <div class="p-5 rounded-2xl border space-y-4" style="background:var(--bg-card); border-color:var(--border)">
          {[
            {
              icon: `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`,
              label: "Email",
              value: "matt.via27@gmail.com",
              href: "mailto:matt.via27@gmail.com",
            },
            {
              icon: `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>`,
              label: "Teléfono",
              value: "+54 3385 466752",
              href: "tel:+543385466752",
            },
            {
              icon: `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
              label: "Ubicación",
              value: "Córdoba, Argentina · Remoto",
              href: null,
            },
          ].map(info => (
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0"
                style="background:var(--accent-bg); color:var(--accent)" set:html={info.icon}></div>
              <div>
                <div class="text-xs mb-0.5" style="color:var(--text-3)">{info.label}</div>
                {info.href ? (
                  <a href={info.href} class="text-xs font-medium hover:underline" style="color:var(--accent)">{info.value}</a>
                ) : (
                  <span class="text-xs" style="color:var(--text-2)">{info.value}</span>
                )}
              </div>
            </div>
          ))}
        </div>

        <!-- Socials -->
        <div class="grid grid-cols-2 gap-3">
          <a href="https://github.com/mativia" target="_blank" rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 py-3 rounded-xl border text-xs font-medium transition-all duration-200 hover:border-[var(--accent)] hover:text-[var(--accent)]"
            style="background:var(--bg-card); border-color:var(--border); color:var(--text-2)">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
            GitHub
          </a>
          <a href="https://www.linkedin.com/in/matias-via" target="_blank" rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 py-3 rounded-xl border text-xs font-medium transition-all duration-200 hover:border-[#0A66C2] hover:text-[#0A66C2]"
            style="background:var(--bg-card); border-color:var(--border); color:var(--text-2)">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            LinkedIn
          </a>
        </div>
      </div>

      <!-- Form (3/5) -->
      <div class="lg:col-span-3 animate-fade-up delay-200">
        <div class="p-6 sm:p-8 rounded-2xl border" style="background:var(--bg-card); border-color:var(--border)">
          <h3 class="text-base font-medium mb-6" style="color:var(--text-1)">Escribime directamente</h3>

          <form id="contact-form" class="space-y-4">
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label for="name" class="block text-xs mb-1.5" style="color:var(--text-3)">Nombre *</label>
                <input type="text" id="name" name="name" required placeholder="Tu nombre"
                  class="contact-input w-full"/>
              </div>
              <div>
                <label for="email" class="block text-xs mb-1.5" style="color:var(--text-3)">Email *</label>
                <input type="email" id="email" name="email" required placeholder="tu@email.com"
                  class="contact-input w-full"/>
              </div>
            </div>

            <div>
              <label for="subject" class="block text-xs mb-1.5" style="color:var(--text-3)">Asunto *</label>
              <input type="text" id="subject" name="subject" required placeholder="Propuesta de trabajo, proyecto o consulta"
                class="contact-input w-full"/>
            </div>

            <div>
              <label for="message" class="block text-xs mb-1.5" style="color:var(--text-3)">Mensaje *</label>
              <textarea id="message" name="message" rows="5" required
                placeholder="Contame sobre la posición, el equipo o el proyecto..."
                class="contact-input w-full resize-none"></textarea>
            </div>

            <button type="submit" id="submit-btn"
              class="w-full py-3 rounded-xl text-sm font-medium text-white transition-all duration-200 hover:opacity-90 disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2"
              style="background:var(--accent)">
              <span id="submit-text">Enviar →</span>
              <span id="submit-loading" class="hidden items-center gap-2">
                <svg class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"/>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
                </svg>
                Enviando...
              </span>
            </button>
          </form>

          <div id="form-message" class="mt-4 hidden">
            <div id="success-message" class="hidden px-4 py-3 rounded-xl text-xs"
              style="background:color-mix(in srgb,var(--green) 10%,transparent); color:var(--green); border:1px solid color-mix(in srgb,var(--green) 25%,transparent)">
              Mensaje enviado. Te respondo en menos de 24 hs.
            </div>
            <div id="error-message" class="hidden px-4 py-3 rounded-xl text-xs"
              style="background:rgba(239,68,68,.08); color:#F87171; border:1px solid rgba(239,68,68,.2)">
              Hubo un error. Intentalo de nuevo o escribime directamente al email.
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  .contact-input {
    padding: 0.625rem 0.875rem;
    font-size: 0.875rem;
    border-radius: 0.625rem;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--text-1);
    transition: border-color .2s, box-shadow .2s;
    outline: none;
    font-family: 'DM Sans', system-ui, sans-serif;
  }
  .contact-input::placeholder { color: var(--text-3); }
  .contact-input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-ring);
  }
</style>

<script>
  import emailjs from '@emailjs/browser';

  document.addEventListener('DOMContentLoaded', () => {
    const form     = document.getElementById('contact-form') as HTMLFormElement | null;
    const btn      = document.getElementById('submit-btn')  as HTMLButtonElement | null;
    const txtEl    = document.getElementById('submit-text');
    const loadEl   = document.getElementById('submit-loading');
    const msgBox   = document.getElementById('form-message');
    const successEl = document.getElementById('success-message');
    const errorEl  = document.getElementById('error-message');

    if (!form || !btn) return;

    const SVC = 'service_hqi6j2m';
    const TPL = 'template_qm4bvif';
    const KEY = 'a673vj3dQEHIp5rUX';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      btn.disabled = true;
      txtEl?.classList.add('hidden');
      loadEl?.classList.remove('hidden');
      loadEl?.classList.add('flex');

      try {
        await emailjs.sendForm(SVC, TPL, form, KEY);
        msgBox?.classList.remove('hidden');
        successEl?.classList.remove('hidden');
        errorEl?.classList.add('hidden');
        form.reset();
      } catch {
        msgBox?.classList.remove('hidden');
        errorEl?.classList.remove('hidden');
        successEl?.classList.add('hidden');
      } finally {
        btn.disabled = false;
        txtEl?.classList.remove('hidden');
        loadEl?.classList.add('hidden');
        loadEl?.classList.remove('flex');
      }
    });
  });
</script>
