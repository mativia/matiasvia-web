---
const cats = [
  {
    title: "Lenguajes & Backend",
    color: "#60A5FA",
    skills: [
      { name: "C# · ASP.NET · EF", level: 90 },
      { name: "Java · Spring · Hibernate", level: 75 },
      { name: "JavaScript", level: 70 },
      { name: "Python · Django · Flask", level: 65 },
      { name: "SQL · MySQL · PostgreSQL", level: 50 },
    ],
  },
  {
    title: "Frontend & CMS",
    color: "#A78BFA",
    skills: [
      { name: "HTML / CSS · Tailwind", level: 90 },
      { name: "React", level: 86 },
      { name: "Astro", level: 70 },
      { name: "WordPress · WooCommerce", level: 90 },
      { name: "UI / UX", level: 70 },
    ],
  },
  {
    title: "Análisis de Sistemas",
    color: "#34D399",
    skills: [
      { name: "Captura de requerimientos", level: 95 },
      { name: "Modelado UML & BPMN", level: 90 },
      { name: "Análisis funcional", level: 90 },
      { name: "Procesos organizacionales", level: 80 },
      { name: "Comunicación efectiva", level: 85 },
    ],
  },
  {
    title: "Herramientas & Metodologías",
    color: "#FB923C",
    skills: [
      { name: "Git · GitHub · GitLab", level: 100 },
      { name: "Scrum", level: 92 },
      { name: "Jira", level: 100 },
      { name: "IA aplicada · Prompt Eng.", level: 86 },
      { name: "Docker", level: 60 },
    ],
  },
];
---

<section id="skills" class="py-24 sm:py-32" style="background:var(--bg)">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="mb-14 animate-fade-up">
      <p class="text-xs font-medium uppercase tracking-widest mb-3" style="color:var(--accent)">Qué sé hacer</p>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold" style="color:var(--text-1)">
        Stack técnico
      </h2>
      <p class="mt-4 text-sm sm:text-base max-w-xl" style="color:var(--text-2)">
        Tecnologías con las que trabajo a diario en proyectos reales — no solo en cursos.
      </p>
    </div>

    <!-- Skills grid -->
    <div class="grid sm:grid-cols-2 gap-5 mb-10">
      {cats.map((cat, ci) => (
        <div
          class="rounded-2xl border p-6 animate-fade-up"
          style={`background:var(--bg-card); border-color:var(--border); animation-delay:${ci * 0.1}s`}
        >
          <!-- Category header -->
          <div class="flex items-center gap-3 mb-5 pb-4 border-b" style="border-color:var(--border-soft)">
            <div class="w-2 h-6 rounded-full" style={`background:${cat.color}`}></div>
            <h3 class="text-sm font-medium" style="color:var(--text-1)">{cat.title}</h3>
          </div>

          <!-- Skill bars -->
          <div class="space-y-3.5">
            {cat.skills.map(skill => (
              <div class="skill-item">
                <div class="flex justify-between items-center mb-1.5">
                  <span class="text-xs" style="color:var(--text-2)">{skill.name}</span>
                  <span class="text-xs tabular-nums font-mono" style={`color:${cat.color}`}>{skill.level}%</span>
                </div>
                <div class="w-full h-1.5 rounded-full" style="background:var(--bg-muted)">
                  <div
                    class="skill-bar h-full rounded-full transition-all duration-700 ease-out"
                    style={`width:0%; background:${cat.color}; box-shadow:0 0 8px ${cat.color}40`}
                    data-level={skill.level}
                  ></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Dev process -->
    <div class="rounded-2xl border p-6 sm:p-8 mb-8 animate-fade-up delay-400"
      style="background:var(--bg-card); border-color:var(--border)">
      <h3 class="text-sm font-medium mb-7" style="color:var(--text-1)">Proceso de desarrollo</h3>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-6">
        {[
          { num: "01", name: "Análisis",    desc: "Entiendo el problema antes de escribir una línea de código. Levanto requisitos, pregunto, modelo.",    color: "#60A5FA" },
          { num: "02", name: "Desarrollo",  desc: "Código limpio, commits descriptivos y ramas organizadas. Me adapto al estilo del equipo.", color: "#A78BFA" },
          { num: "03", name: "Revisión",    desc: "Testeo lo que construyo. No entrego sin haberlo probado yo mismo en escenarios reales.",       color: "#34D399" },
          { num: "04", name: "Entrega",     desc: "Despiego, documento y acompaño. No desaparezco cuando el proyecto está listo.",          color: "#FB923C" },
        ].map(step => (
          <div class="relative">
            <div class="font-display text-3xl font-bold mb-2 opacity-15" style={`color:${step.color}`}>{step.num}</div>
            <div class="text-sm font-medium mb-1" style="color:var(--text-1)">{step.name}</div>
            <div class="text-xs leading-relaxed" style="color:var(--text-3)">{step.desc}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- Languages -->
    <div class="flex flex-wrap gap-3 animate-fade-up delay-500">
      {[
        { lang: "Español", level: "Nativo", color: "var(--accent)" },
        { lang: "Inglés", level: "Básico / Intermedio", color: "var(--text-3)" },
      ].map(l => (
        <div class="flex items-center gap-3 px-5 py-3 rounded-xl border" style="background:var(--bg-card); border-color:var(--border)">
          <div class="w-2 h-2 rounded-full" style={`background:${l.color}`}></div>
          <span class="text-sm font-medium" style="color:var(--text-1)">{l.lang}</span>
          <span class="text-xs" style="color:var(--text-3)">{l.level}</span>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  function initBars() {
    const bars = document.querySelectorAll<HTMLElement>('.skill-bar');
    const section = document.getElementById('skills');
    if (!section || !bars.length) return;

    const obs = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) {
        bars.forEach((bar, i) => {
          const lv = bar.getAttribute('data-level') ?? '0';
          setTimeout(() => { bar.style.width = `${lv}%`; }, i * 50 + 100);
        });
        obs.disconnect();
      }
    }, { threshold: 0.15 });

    obs.observe(section);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initBars);
  else initBars();
  document.addEventListener('astro:page-load', initBars);
</script>
