---
import profileImage from '../assets/cv-profile.jpg';
---

<section id="about" class="py-24 sm:py-32" style="background:var(--bg-muted)">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="mb-14 animate-fade-up">
      <p class="text-xs font-medium uppercase tracking-widest mb-3" style="color:var(--accent)">Por qué contratarme</p>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight" style="color:var(--text-1)">
        Lo que aporto a tu equipo
      </h2>
    </div>

    <div class="grid lg:grid-cols-5 gap-12 lg:gap-16 items-start">

      <!-- Photo col (2/5) -->
      <div class="lg:col-span-2 animate-fade-up delay-100">
        <!-- Photo with decorative frame -->
        <div class="relative max-w-xs mx-auto lg:mx-0">
          <!-- Decorative border offset -->
          <div class="absolute inset-0 translate-x-3 translate-y-3 rounded-2xl border-2 opacity-30"
            style="border-color:var(--accent)"></div>
          <div class="relative rounded-2xl overflow-hidden border" style="border-color:var(--border)">
            <img
              src={profileImage.src}
              alt="Matías Vía — Analista en Sistemas"
              class="w-full aspect-square object-cover"
            />
          </div>
        </div>

        <!-- Quick facts -->
        <div class="mt-8 space-y-3 max-w-xs mx-auto lg:mx-0">
          {[
            { icon: "📍", label: "Córdoba, Argentina · Trabajo remoto" },
            { icon: "🎓", label: "UTN·FRC — Ingeniería en Sistemas (cursando)" },
            { icon: "⚡", label: "Integración de IA en flujos productivos" },
          ].map(f => (
            <div class="flex items-center gap-3 px-4 py-3 rounded-xl border" style="background:var(--bg-card); border-color:var(--border)">
              <span class="text-lg shrink-0">{f.icon}</span>
              <span class="text-sm" style="color:var(--text-2)">{f.label}</span>
            </div>
          ))}
          <!-- Available badge -->
          <div class="flex items-center gap-3 px-4 py-3 rounded-xl border"
            style="background:color-mix(in srgb,var(--green) 8%,transparent); border-color:color-mix(in srgb,var(--green) 25%,transparent)">
            <span class="w-2 h-2 rounded-full bg-[var(--green)] animate-pulse shrink-0"></span>
            <span class="text-sm font-medium" style="color:var(--green)">Disponible · Incorporación inmediata</span>
          </div>
        </div>
      </div>

      <!-- Content col (3/5) -->
      <div class="lg:col-span-3 space-y-8 animate-fade-up delay-200">

        <!-- Bio -->
        <div class="space-y-4 text-sm sm:text-base leading-relaxed" style="color:var(--text-2)">
          <p>
            Soy <span class="font-medium" style="color:var(--text-1)">Matías Vía</span>, desarrollador full-stack con experiencia real en proyectos
            freelance: e-commerce, sistemas de gestión y automatización de procesos. Actualmente cursando
            el último tramo de Ingeniería en Sistemas en UTN·FRC y próximo a obtener el título de Analista en Sistemas.
          </p>
          <p>
            Integro <span class="font-medium" style="color:var(--accent)">inteligencia artificial</span> en mis flujos de trabajo para acortar tiempos
            de entrega sin sacrificar calidad. No uso la IA como un atajo: la orquesto con criterio técnico,
            revisando cada output con los conocimientos que la carrera me dio.
          </p>
          <p>
            Me adapto rápido a equipos y metodologías. Trabajo con Scrum, manejo Git en equipo,
            comunico avances con claridad y entrego funcionalidades completas — no parches.
            Busco una empresa donde seguir creciendo y aportar valor desde el primer día.
          </p>
        </div>

        <!-- Principles -->
        <div>
          <h3 class="text-sm font-medium mb-4" style="color:var(--text-1)">Lo que me diferencia</h3>
          <div class="grid sm:grid-cols-3 gap-3">
            {[
              { icon: "🚀", title: "Entrego, no prometo", desc: "Historial real de proyectos terminados y en producción." },
              { icon: "🤝", title: "Trabajo en equipo", desc: "Scrum, Git colaborativo y comunicación constante." },
              { icon: "🧠", title: "IA como ventaja", desc: "Produzco más en menos tiempo sin bajar la calidad." },
            ].map(p => (
              <div class="p-4 rounded-xl border transition-colors duration-200 hover:border-[var(--accent)]"
                style="background:var(--bg); border-color:var(--border)">
                <div class="text-2xl mb-2">{p.icon}</div>
                <div class="text-xs font-medium mb-1" style="color:var(--text-1)">{p.title}</div>
                <div class="text-xs" style="color:var(--text-3)">{p.desc}</div>
              </div>
            ))}
          </div>
        </div>

        <!-- Experience timeline -->
        <div>
          <h3 class="text-sm font-medium mb-5" style="color:var(--text-1)">Experiencia</h3>
          <div class="space-y-5">
            {[
              {
                role: "Desarrollador Python — Sistema de gestión comercial",
                type: "Freelance · 2024",
                desc: "Construí desde cero una app de escritorio con Tkinter y SQLite que automatizó la facturación y los reportes semanales de una panadería, eliminando el trabajo manual del equipo.",
                accent: "var(--accent)",
              },
              {
                role: "Desarrollador Web — WordPress & WooCommerce",
                type: "Freelance · 2023–2024",
                desc: "Desarrollé y lancé tres proyectos para clientes reales: tienda Osaka (e-commerce con pagos integrados), landing GoGo Travel (orientada a conversión) y Quantum Sports (indumentaria deportiva).",
                accent: "var(--accent)",
              },
              {
                role: "Técnico VDC — Infraestructura de redes",
                type: "2022–2023",
                desc: "Instalación y configuración de cableado estructurado, redes Wi-Fi corporativas, telefonía IP e impresoras en red.",
                accent: "var(--text-3)",
              },
            ].map(exp => (
              <div class="relative pl-5 border-l" style={`border-color:${exp.accent}; border-left-width:2px`}>
                <div class="text-sm font-medium" style="color:var(--text-1)">{exp.role}</div>
                <div class="text-xs mb-1.5" style={`color:${exp.accent}`}>{exp.type}</div>
                <div class="text-xs leading-relaxed" style="color:var(--text-2)">{exp.desc}</div>
              </div>
            ))}
          </div>
        </div>

        <!-- CTA -->
        <a href="#contact"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl text-sm font-medium text-white transition-all duration-200 hover:opacity-90 hover:scale-105"
          style="background:var(--accent)">
          Solicitar entrevista
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
