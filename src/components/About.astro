---
import profileImage from '../assets/WhatsApp Image 2024-08-01 at 10.42.17.jpeg';
---

<section id="about" class="py-24 sm:py-32" style="background:var(--bg-muted)">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="mb-14 animate-fade-up">
      <p class="text-xs font-medium uppercase tracking-widest mb-3" style="color:var(--accent)">Sobre mí</p>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight" style="color:var(--text-1)">
        Quién soy
      </h2>
    </div>

    <div class="grid lg:grid-cols-5 gap-12 lg:gap-16 items-start">

      <!-- Photo col (2/5) -->
      <div class="lg:col-span-2 animate-fade-up delay-100">
        <!-- Photo with decorative frame -->
        <div class="relative max-w-xs mx-auto lg:mx-0">
          <!-- Decorative border offset -->
          <div class="absolute inset-0 translate-x-3 translate-y-3 rounded-2xl border-2 opacity-30"
            style="border-color:var(--accent)"></div>
          <div class="relative rounded-2xl overflow-hidden border" style="border-color:var(--border)">
            <img
              src={profileImage.src}
              alt="Matías Vía — Analista en Sistemas"
              class="w-full aspect-square object-cover"
            />
          </div>
        </div>

        <!-- Quick facts -->
        <div class="mt-8 space-y-3 max-w-xs mx-auto lg:mx-0">
          {[
            { icon: "📍", label: "Córdoba, Argentina · Remoto" },
            { icon: "🎓", label: "UTN·FRC — Ingeniería en Sistemas" },
            { icon: "⚡", label: "Especialización en IA aplicada" },
          ].map(f => (
            <div class="flex items-center gap-3 px-4 py-3 rounded-xl border" style="background:var(--bg-card); border-color:var(--border)">
              <span class="text-lg shrink-0">{f.icon}</span>
              <span class="text-sm" style="color:var(--text-2)">{f.label}</span>
            </div>
          ))}
          <!-- Available badge -->
          <div class="flex items-center gap-3 px-4 py-3 rounded-xl border"
            style="background:color-mix(in srgb,var(--green) 8%,transparent); border-color:color-mix(in srgb,var(--green) 25%,transparent)">
            <span class="w-2 h-2 rounded-full bg-[var(--green)] animate-pulse shrink-0"></span>
            <span class="text-sm font-medium" style="color:var(--green)">Disponible para proyectos</span>
          </div>
        </div>
      </div>

      <!-- Content col (3/5) -->
      <div class="lg:col-span-3 space-y-8 animate-fade-up delay-200">

        <!-- Bio -->
        <div class="space-y-4 text-sm sm:text-base leading-relaxed" style="color:var(--text-2)">
          <p>
            Soy <span class="font-medium" style="color:var(--text-1)">Mati</span>, estudiante avanzado de Ingeniería en Sistemas en la UTN·FRC,
            próximo a obtener el título de Analista en Sistemas. Disfruto transformar ideas en productos
            digitales y construir soluciones que generen un impacto real.
          </p>
          <p>
            Me apasiona integrar la <span class="font-medium" style="color:var(--accent)">inteligencia artificial</span> en mis proyectos para
            agilizar procesos y ofrecer respuestas en tiempo récord. Uso la IA de forma consciente y
            estratégica, aplicando los conocimientos académicos para dirigirla con criterio y buenas prácticas.
          </p>
          <p>
            Cuento con experiencia en desarrollo web y software a medida, trabajando de forma independiente
            y en equipos ágiles con Scrum. Busco sumarme a equipos que valoren la innovación y la mejora continua.
          </p>
        </div>

        <!-- Principles -->
        <div>
          <h3 class="text-sm font-medium mb-4" style="color:var(--text-1)">Principios de trabajo</h3>
          <div class="grid sm:grid-cols-3 gap-3">
            {[
              { icon: "🧹", title: "Código limpio", desc: "Mantenible, legible y escalable." },
              { icon: "🔄", title: "Aprendizaje continuo", desc: "Siempre mejorando y actualizándome." },
              { icon: "🎯", title: "Foco en el usuario", desc: "UX intuitiva en cada interfaz." },
            ].map(p => (
              <div class="p-4 rounded-xl border transition-colors duration-200 hover:border-[var(--accent)]"
                style="background:var(--bg); border-color:var(--border)">
                <div class="text-2xl mb-2">{p.icon}</div>
                <div class="text-xs font-medium mb-1" style="color:var(--text-1)">{p.title}</div>
                <div class="text-xs" style="color:var(--text-3)">{p.desc}</div>
              </div>
            ))}
          </div>
        </div>

        <!-- Experience timeline -->
        <div>
          <h3 class="text-sm font-medium mb-5" style="color:var(--text-1)">Experiencia</h3>
          <div class="space-y-5">
            {[
              {
                role: "Desarrollador Python · Gestión de ventas",
                type: "Freelance · 2024",
                desc: "App de escritorio (Tkinter + SQLite) con facturas PDF y reportes automatizados semanales.",
                accent: "var(--accent)",
              },
              {
                role: "Web Developer · WordPress & WooCommerce",
                type: "Freelance · 2023–2024",
                desc: "Osaka (e-commerce), GoGo Travel (landing SEO) y Quantum Sports (tienda deportiva).",
                accent: "var(--accent)",
              },
              {
                role: "Técnico VDC — Infraestructura",
                type: "2022–2023",
                desc: "Cableado estructurado, redes Wi-Fi, impresoras y telefonía IP.",
                accent: "var(--text-3)",
              },
            ].map(exp => (
              <div class="relative pl-5 border-l" style={`border-color:${exp.accent}; border-left-width:2px`}>
                <div class="text-sm font-medium" style="color:var(--text-1)">{exp.role}</div>
                <div class="text-xs mb-1.5" style={`color:${exp.accent}`}>{exp.type}</div>
                <div class="text-xs leading-relaxed" style="color:var(--text-2)">{exp.desc}</div>
              </div>
            ))}
          </div>
        </div>

        <!-- CTA -->
        <a href="#contact"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl text-sm font-medium text-white transition-all duration-200 hover:opacity-90 hover:scale-105"
          style="background:var(--accent)">
          Trabajemos juntos
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
