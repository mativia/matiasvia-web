---
import ProjectCard from './ProjectCard.astro';

const projects = [
  {
    title: "Sistema de ventas y facturación",
    description: "Automaticé por completo la operación de una panadería: registro de ventas, emisión de facturas PDF y reportes semanales automáticos. El cliente dejó de dedicar horas a tareas manuales.",
    technologies: ["Python", "Tkinter", "SQLite", "PDF"],
    badge: "destacado" as const,
    year: "2024",
    category: "automatización" as const,
    githubUrl: "https://github.com/mativia",
    featured: true,
  },
  {
    title: "Osaka · Tienda WooCommerce",
    description: "E-commerce funcional y a medida: catálogo, carrito, pasarela de pagos, child-theme en PHP/CSS y optimización de carga. El negocio pasó de vender solo en persona a tener canal online.",
    technologies: ["WordPress", "WooCommerce", "PHP", "CSS", "SEO"],
    badge: "e-commerce" as const,
    year: "2024",
    category: "e-commerce" as const,
  },
  {
    title: "GoGo Travel · Landing de conversión",
    description: "Diseñé y desarrollé una landing orientada a captura de leads para una agencia de viajes. Formularios integrados, copy enfocado en conversión y estructura SEO desde el día uno.",
    technologies: ["WordPress", "Elementor", "UX", "SEO"],
    badge: "freelance" as const,
    year: "2023",
    category: "web" as const,
  },
  {
    title: "Quantum Sports · E-commerce",
    description: "Tienda online completa para una marca de indumentaria deportiva: catálogo con variantes, experiencia de compra mobile-first y configuración de envíos y logística.",
    technologies: ["WooCommerce", "PHP", "Responsive", "UX"],
    badge: "e-commerce" as const,
    year: "2024",
    category: "e-commerce" as const,
  },
  {
    title: "Autoclinic · Gestión de talleres",
    description: "Sistema de gestión integral para talleres mecánicos: turnos, historial de reparaciones por vehículo, base de clientes y reportes. Desarrollado como proyecto de seminario académico.",
    technologies: ["C#", "Windows Forms", "MySQL", "POO"],
    badge: "académico" as const,
    year: "2025",
    category: "académico" as const,
  },
  {
    title: "Aerolínea · Sistema de pasajes",
    description: "Aplicación de gestión para venta y administración de pasajes aéreos con panel de control, reportes de ocupación y manejo de roles. Proyecto académico con base de datos real.",
    technologies: ["C#", "Windows Forms", "MySQL", "SQL"],
    badge: "académico" as const,
    year: "2024",
    category: "académico" as const,
  },
];

const filters = [
  { label: "Todos", value: "all" },
  { label: "Automatización", value: "automatización" },
  { label: "E-commerce", value: "e-commerce" },
  { label: "Web", value: "web" },
  { label: "Académico", value: "académico" },
];
---

<section id="projects" class="py-24 sm:py-32" style="background:var(--bg-muted)">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="mb-12 animate-fade-up">
      <p class="text-xs font-medium uppercase tracking-widest mb-3" style="color:var(--accent)">Trabajo real, resultados concretos</p>
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold" style="color:var(--text-1)">
          Proyectos
        </h2>
        <a href="https://github.com/mativia?tab=repositories" target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm transition-colors duration-200 hover:underline shrink-0"
          style="color:var(--accent)">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
          Ver GitHub →
        </a>
      </div>
    </div>

    <!-- Filters — scroll horizontal en mobile -->
    <div class="flex gap-2 mb-10 overflow-x-auto pb-2 -mx-4 px-4 sm:mx-0 sm:px-0 sm:flex-wrap animate-fade-up delay-100">
      {filters.map((f, i) => (
        <button
          class={`filter-btn shrink-0 px-4 py-1.5 rounded-full text-xs font-medium border transition-all duration-200 whitespace-nowrap ${i === 0 ? "active" : ""}`}
          data-filter={f.value}
          style={i === 0
            ? "background:var(--accent); color:#fff; border-color:var(--accent)"
            : "background:var(--bg-card); color:var(--text-2); border-color:var(--border)"}
        >
          {f.label}
        </button>
      ))}
    </div>

    <!-- Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-14" id="projects-grid">
      {projects.map(p => (
        <div class="project-item animate-fade-up delay-200" data-category={p.category}>
          <ProjectCard {...p} />
        </div>
      ))}
    </div>

    <div id="no-results" class="hidden py-20 text-center text-sm" style="color:var(--text-3)">
      No hay proyectos en esta categoría.
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-5 pt-10 border-t animate-fade-up delay-300"
      style="border-color:var(--border)">
      {[
        { value: "15+", label: "Proyectos entregados" },
        { value: "3",   label: "Clientes reales" },
        { value: "100%", label: "Proyectos terminados" },
        { value: "2+",  label: "Años de experiencia" },
      ].map(s => (
        <div class="text-center p-5 rounded-xl border transition-colors duration-200 hover:border-[var(--accent)]"
          style="background:var(--bg-card); border-color:var(--border)">
          <div class="font-display text-2xl sm:text-3xl font-bold mb-1" style="color:var(--text-1)">{s.value}</div>
          <div class="text-xs" style="color:var(--text-3)">{s.label}</div>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="mt-10 flex flex-col sm:flex-row gap-3 justify-center animate-fade-up delay-400">
      <a href="#contact"
        class="px-6 py-3 rounded-xl text-sm font-medium text-white text-center transition-all duration-200 hover:opacity-90"
        style="background:var(--accent)">
        Contactarme →
      </a>
      <a href="https://github.com/mativia" target="_blank" rel="noopener noreferrer"
        class="px-6 py-3 rounded-xl text-sm font-medium text-center border transition-colors duration-200 hover:border-[var(--accent)] hover:text-[var(--accent)]"
        style="border-color:var(--border); color:var(--text-2)">
        Ver más en GitHub
      </a>
    </div>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btns  = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const items = document.querySelectorAll<HTMLElement>('.project-item');
    const noRes = document.getElementById('no-results');

    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter ?? 'all';

        btns.forEach(b => {
          b.classList.remove('active');
          b.style.background = 'var(--bg-card)';
          b.style.color      = 'var(--text-2)';
          b.style.borderColor = 'var(--border)';
        });
        btn.classList.add('active');
        btn.style.background  = 'var(--accent)';
        btn.style.color       = '#fff';
        btn.style.borderColor = 'var(--accent)';

        let visible = 0;
        items.forEach(item => {
          const show = filter === 'all' || item.dataset.category === filter;
          item.style.display = show ? '' : 'none';
          if (show) visible++;
        });
        noRes?.classList.toggle('hidden', visible > 0);
      });
    });
  });
</script>
